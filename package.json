{
	"name": "obsidian-interval-timer",
	"version": "0.9.0",
	"description": "Interval Timer for Obsidian",
	"main": "main.js",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "npx eslint . --suppressions-location eslint-suppressions.local.json && npm run lint:styles",
		"lint:styles": "stylelint \"src/**/*.css\" \"index.css\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"coverage": "vitest run --coverage"
	},
	"keywords": [],
	"author": "tamiroh",
	"license": "MIT",
	"devDependencies": {
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@fast-check/vitest": "0.5.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/user-event": "14.6.7",
		"@types/node": "26.6.4",
		"@typescript-eslint/utils": "8.71.0",
		"@vitest/coverage-v8": "5.0.3",
		"@vitest/eslint-plugin": "1.6.27",
		"esbuild": "0.28.2",
		"eslint": "10.12.0",
		"eslint-plugin-jest-dom": "5.10.1",
		"eslint-plugin-obsidianmd": "0.4.2",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-testing-library": "7.16.2",
		"fast-check": "4.10.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"jsdom": "30.1.2",
		"obsidian": "1.13.1",
		"prettier": "3.9.9",
		"stylelint": "17.16.0",
		"stylelint-config-recess-order": "7.8.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-order": "8.1.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"preact": "11.0.0",
		"ts-pattern": "5.9.0",
		"valibot": "1.5.0"
	}
}
