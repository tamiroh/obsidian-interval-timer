{
	"name": "obsidian-interval-timer",
	"version": "0.8.0",
	"description": "Interval Timer for Obsidian",
	"main": "main.js",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "npx eslint . && npm run lint:styles",
		"lint:styles": "stylelint \"src/**/*.css\" \"index.css\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"coverage": "vitest run --coverage"
	},
	"keywords": [],
	"author": "tamiroh",
	"license": "MIT",
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^10.0.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/user-event": "^14.6.6",
		"@types/node": "^26.1.2",
		"@typescript-eslint/utils": "^8.68.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/eslint-plugin": "^1.6.27",
		"esbuild": "0.28.1",
		"eslint": "^10.8.0",
		"eslint-plugin-jest-dom": "^5.10.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-testing-library": "^7.16.2",
		"globals": "^17.8.0",
		"jiti": "^2.7.0",
		"jsdom": "^30.0.1",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.6",
		"stylelint": "^17.14.1",
		"stylelint-config-recess-order": "^7.8.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-order": "^8.1.1",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"preact": "^10.29.8",
		"ts-pattern": "^5.9.0",
		"valibot": "^1.4.2"
	}
}
